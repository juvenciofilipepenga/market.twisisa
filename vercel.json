{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap?part=index"
    },
    {
      "source": "/sitemap-:part.xml",
      "destination": "/api/sitemap?part=:part"
    },
    {
      "source": "/produto/:id",
      "destination": "/api/render?type=product&id=:id"
    },
    {
      "source": "/categoria/:slug",
      "destination": "/api/render?type=category&slug=:slug"
    },
    {
      "source": "/(carrinho|perfil|notificacoes|instalar|definicoes|mais|pedidos|convites|pesquisa|termos|privacidade|cookies|mapa-do-site|entrar|registar|recuperar|redefinir)",
      "destination": "/index.html"
    },
    {
      "source": "/(encomenda|notificacoes|pagamento)/:id",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/render?type=notfound"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.ico|logo.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(img|icons)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), microphone=()"
        }
      ]
    }
  ]
}